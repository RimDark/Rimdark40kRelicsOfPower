<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Fires once per save on success; a failed run is retried after a delay. -->
  <Core40k.PersistentQuestDef>
    <defName>BEWH_TheStandingOrder</defName>
    <quest>
      <incident>BEWH_TheStandingOrder</incident>
      <minDaysPassed>30</minDaysPassed>
      <retryDelayDaysRange>25~40</retryDelayDaysRange>
      <failedFireRetryDaysRange>1~3</failedFireRetryDaysRange>
      <completionMode>QuestSuccess</completionMode>
      <maxOccurrences>-1</maxOccurrences>
      <allowedTargetTags>
        <li>World</li>
      </allowedTargetTags>
    </quest>
  </Core40k.PersistentQuestDef>

</Defs>
