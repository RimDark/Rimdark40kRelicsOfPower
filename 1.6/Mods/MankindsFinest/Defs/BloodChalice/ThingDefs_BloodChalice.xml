<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef>
    <defName>BEWH_BloodChalice</defName>
    <label>blood chalice</label>
    <thingClass>ThingWithComps</thingClass>
    <description>A wide-mouthed goblet of red gold, its rim worn smooth by ten thousand years of lips. The vessel is never empty and never filled: whatever is poured out of it is back within the hour, thick and dark and faintly warm.\n\nThe chalice does not give life. It gives back what was taken. Wounds close, scars unknit, sickness burns out of the blood, and the drinker's thirst is answered to the brim. But what is gone is gone - the chalice restores flesh to a body, not a body to itself. A hand severed stays severed, and no draught has ever grown one back.\n\nOnly those whose blood already runs on the red thirst can drink from it. In anyone else the draught is inert, and the chalice will not be lifted.</description>
    <graphicData>
      <texPath>Things/BEWH_BloodChalice</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.85, 0.85)</drawSize>
    </graphicData>
    <category>Item</category>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Mass>1.4</Mass>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <MarketValue>25000</MarketValue>
      <Beauty>16</Beauty>
    </statBases>
    <stackLimit>1</stackLimit>
    <tradeability>None</tradeability>
    <healthAffectsPrice>false</healthAffectsPrice>
    <intricate>true</intricate>
    <selectable>true</selectable>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <rotatable>false</rotatable>
    <drawGUIOverlay>false</drawGUIOverlay>
    <pathCost>14</pathCost>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Drink from the blood chalice</useLabel>
        <useDuration>300</useDuration>
        <showUseGizmo>true</showUseGizmo>
      </li>
      <li Class="Relics40k.CompProperties_UseEffectBloodChalice" />
    </comps>
    <modExtensions>
      <li Class="Relics40k.DefModExtension_BloodChalice">
        <!-- 900000 ticks = 15 in-game days. -->
        <cooldownTicks>900000</cooldownTicks>
        <healInjuries>true</healInjuries>
        <cureBadHediffs>true</cureBadHediffs>
        <sealStumps>true</sealStumps>
        <fillHemogen>true</fillHemogen>
        <fillDeathrestNeed>true</fillDeathrestNeed>
        <moodThought>BEWH_BloodChaliceDraught</moodThought>
        <excludedHediffs />
      </li>
    </modExtensions>
  </ThingDef>

</Defs>